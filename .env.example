# Easiest path: run `python bridge.py setup` and it writes this file for you.
# Otherwise, copy to .env and fill in by hand (then chmod 600 .env).

BRIDGE_TOKEN=            # generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_ENABLED=false   # flip to true after `python bridge.py login`
ASSISTANT_CHAT=          # @botusername (or chat id) of the Telegram DM your assistant lives in
ASSISTANT_NAME=assistant # becomes the MCP tool name, e.g. Hermes -> send_to_hermes
TG_API_ID=               # from https://my.telegram.org/apps
TG_API_HASH=
SESSION_NAME=ringbearer

# RING_PREFIX=🎤          # prefix on relayed messages (default: mic emoji)
# MCP_MOUNT=/bridge       # MCP endpoint becomes <MCP_MOUNT>/mcp
