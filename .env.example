# Easiest path: run `python ringbearer.py setup` and it writes this file for you.
# Otherwise, copy to .env and fill in by hand (then chmod 600 .env).

BRIDGE_TOKEN=            # generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_ENABLED=false   # flip to true after `python ringbearer.py login`
NEW_TOPIC_PER_CAPTURE=false # true creates a fresh Telegram topic for every capture
ASSISTANT_CHAT=          # @botusername (or chat id) of the Telegram DM your assistant lives in
ASSISTANT_NAME=assistant # how the tool describes your assistant to the ring app's LLM (e.g. Hermes)
TG_API_ID=               # from https://my.telegram.org/apps
TG_API_HASH=
BIND_HOST=               # IP your phone can reach — Tailscale IP recommended; LAN IP works but is network-visible and home-only
BIND_PORT=8787
SESSION_NAME=ringbearer

# RING_PREFIX=🎤          # prefix on relayed messages (default: mic emoji)
# MCP_MOUNT=/ringbearer       # MCP endpoint becomes <MCP_MOUNT>/mcp
# ASSISTANTS=plutus:@plutus_bot,qm:@qm_bot   # optional extra assistants — see README "Multiple assistants"
